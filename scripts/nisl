#!/bin/bash

# `nisl hits [slug]` (HAND-22): who used the book's hi- links, from the
# shortener database on Luke's Postgres (home-infra, admin-analytics-db on
# luke.local:5433). Needs the LAN and psql. No password lives here: libpq reads
# it from ~/.pgpass or PGPASSWORD, or set SHORTENER_DATABASE_URL in full.
if [[ "hits" == "$1" ]]; then
    DB_URL="${SHORTENER_DATABASE_URL:-postgresql://claude@luke.local:5433/shortener}"
    if ! command -v psql > /dev/null; then
        echo "nisl hits needs psql (brew install libpq)" >&2
        exit 1
    fi
    if [ -z "$2" ]; then
        psql "$DB_URL" -X -P footer=off -c \
            "SELECT short_path, hits, qr, link, first_at::date AS first, last_at::date AS last
             FROM shortener.hits_by_slug ORDER BY hits DESC, short_path"
    else
        # Accept "fig-1-2" or "hi-fig-1-2"; reject anything that isn't a plain slug.
        SLUG="$2"
        [[ "$SLUG" == hi-* ]] || SLUG="hi-$SLUG"
        if [[ ! "$SLUG" =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "not a slug: $2" >&2
            exit 1
        fi
        # On stdin, not -c: psql only interpolates :'slug' (safely quoted) in
        # scripts, never in a -c string.
        psql "$DB_URL" -X -q -P footer=off -v ON_ERROR_STOP=1 -v slug="$SLUG" <<'SQL'
\echo :slug
SELECT source, hits FROM shortener.hits_by_source
 WHERE short_path = :'slug' ORDER BY hits DESC;
SELECT day, hits, qr, link FROM shortener.hits_by_day
 WHERE short_path = :'slug' ORDER BY day DESC LIMIT 30;
SELECT coalesce(country, '?') AS country, hits FROM shortener.hits_by_country
 WHERE short_path = :'slug' ORDER BY hits DESC LIMIT 30;
SQL
    fi
    exit $?
fi

. $(dirname "$0")/nis.env

export AWS_ACCESS_KEY_ID=$NIS_ACCESS_KEY_ID 
export AWS_SECRET_ACCESS_KEY="$NIS_SECRET_ACCESS_KEY"
export AWS_DEFAULT_REGION=eu-west-2
export AWS_REGION=eu-west-2
unset AWS_PROFILE
unset AWS_SESSION_TOKEN
unset AWS_SECURITY_TOKEN

if [ -z "$1" ]; then
    LIMIT=50
    TRUNCATEDLEN=47
elif [[ "all" == "$1" ]]; then
    LIMIT=$((2**32))
    TRUNCATEDLEN=$((2**32 - 3))
else
    LIMIT=$1
    TRUNCATEDLEN=$[$LIMIT - 3]
fi

echo
aws dynamodb scan --table-name redirects | \
	jq -r '["Short", "Long", "Count"], ["=====", "====", "====="], (.Items | sort_by(.shortPath.S | ascii_downcase) | .[] | [.shortPath.S, (if ((.url.S | length) > '$LIMIT') then .url.S[0:'$TRUNCATEDLEN'] + "..." else .url.S end), .hitCount.N]) | @tsv' | \
	column -t
echo

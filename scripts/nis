#!/bin/bash

usage() {
    echo
    echo Usage: nis [--passthrough] shortUrl longUrl
    echo For auto-generation of shortUrl: nis [--passthrough] longUrl
    echo
    echo "  --passthrough  pass the incoming query string on to longUrl"
    echo "                 (longUrl's own parameters win on a clash)"
    echo
    echo Examples:
    echo "  nis blog https://blog.nakomis.com"
    echo "  nis --passthrough alifinder http://127.0.0.1:8765/aliexpress/callback"
    echo
}

passthrough=false
args=()
for arg in "$@"; do
    case "$arg" in
        --passthrough) passthrough=true ;;
        -h|--help) usage; exit 0 ;;
        *) args+=("$arg") ;;
    esac
done

if [ -z "${args[0]}" ]; then
    usage
    exit 0
fi

if [ -z "${args[1]}" ]; then
    echo generating random short url...
    shortUrl=$(head -c 6 /dev/urandom | base64 | head -c 6)
    # shortUrl=$(uuidgen | base64 | head -c 6)
    longUrl=${args[0]}
else
    shortUrl=${args[0]}
    longUrl=${args[1]}
fi

. $(dirname "$0")/nis.env

export AWS_ACCESS_KEY_ID=$NIS_ACCESS_KEY_ID
export AWS_SECRET_ACCESS_KEY="$NIS_SECRET_ACCESS_KEY"
export AWS_DEFAULT_REGION=eu-west-2
export AWS_REGION=eu-west-2
unset AWS_PROFILE
unset AWS_SESSION_TOKEN
unset AWS_SECURITY_TOKEN

extra=
if [ "$passthrough" = true ]; then
    extra=', "passthrough": {"BOOL": true}'
fi

aws dynamodb put-item --table-name redirects --item '{"shortPath": {"S": "'$shortUrl'"}, "hitCount": {"N": "0"}, "url": {"S": "'$longUrl'"}'"$extra"'}' --region eu-west-2

echo https://nakom.is/$shortUrl
echo https://nakom.is/$shortUrl | pbcopy

